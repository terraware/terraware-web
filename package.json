    "geojson": "^0.5.0",
    "hex-rgb": "^5.0.0",
    "immer": "^9.0.21",
    "is-hotkey": "^0.2.0",
    "jszip": "^3.10.2",
    "lodash": "^4.17.21",
    "luxon": "^3.7.2",
    "mapbox-gl": "^3.33.0",
    "material-react-table": "^3.2.1",
    "playcanvas": "2.23.3",
    "re-reselect": "^4.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-error-boundary": "^6.1.6",
    "react-localization": "^2.1.0",
    "react-map-gl": "^8.1.3",
    "react-mixpanel-browser": "^4.1.0",
    "react-redux": "^9.3.0",
    "react-router": "^7.18.4",
    "sanitize-filename": "^1.6.4",
    "slate": "^0.146.0",
    "slate-dom": "^0.146.1",
